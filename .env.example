# Vercel -> Project -> Settings -> Environment Variables (then redeploy)
ANTHROPIC_API_KEY=   # AI cleans file names into artist + title (console.anthropic.com)
AUDD_API_TOKEN=      # recognises a song from 12 seconds of audio (audd.io)
OPENAI_API_KEY=      # Whisper: listens to the song and writes timed lyrics (platform.openai.com)
